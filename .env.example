# SafeRoute environment variables
# Copy to .env.local for local development: cp .env.example .env.local

# Supabase project URL (Supabase Dashboard > Project Settings > Data API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (Supabase Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — server-side only, never expose to client bundles
# (Supabase Dashboard > Project Settings > API Keys)
SUPABASE_SECRET_KEY=

# Google Gemini API key — server-side only (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
